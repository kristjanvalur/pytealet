class SubmissionQueueFull(RuntimeError): ...

class BufGroup:
    @property
    def buffer_size(self) -> int: ...
    @property
    def buffer_count(self) -> int: ...
    @property
    def leased_count(self) -> int: ...
    @property
    def group_id(self) -> int: ...
    @property
    def ring(self) -> Ring | None: ...
    release_callback: Callable[..., object] | None
    def close(self) -> None: ...

class BufView:
    @property
    def length(self) -> int: ...
    @property
    def buffer_id(self) -> int: ...
    @property
    def buf_group(self) -> BufGroup | None: ...
    @property
    def recycled(self) -> bool: ...
    def __bool__(self) -> bool: ...
    def close(self) -> None: ...

class Completion:
    @property
    def user_data(self) -> object: ...
    @user_data.setter
    def user_data(self, value: object) -> None: ...
    @user_data.deleter
    def user_data(self) -> None: ...
    def clear_user_data(self) -> None: ...
    @property
    def kind(self) -> int: ...
    @property
    def res(self) -> int: ...
    @property
    def flags(self) -> int: ...
    @property
    def result(self) -> object: ...
    @property
    def sequence(self) -> int: ...
    @sequence.setter
    def sequence(self, value: int) -> None: ...
    @property
    def multishot(self) -> bool: ...
    @property
    def cancel_target(self) -> object: ...
    @property
    def prepared(self) -> bool: ...
    @property
    def nowait(self) -> bool: ...
    @nowait.setter
    def nowait(self, value: bool) -> None: ...

